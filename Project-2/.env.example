# Serverless Feedback Pulse - Root Environment Configuration

# Environment Mode: 'development' (local simulation) or 'production' (live OCI cloud)
APP_ENV=development
PORT=8000

# -----------------------------------------------------------------------------
# REAL ORACLE CLOUD INFRASTRUCTURE (OCI) CREDENTIALS
# -----------------------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example_compartment_ocid
OCI_REGION=us-ashburn-1

# OCI Functions & API Gateway Settings
OCI_FUNCTION_OCID=ocid1.fnfunc.oc1.iad.example_function_ocid
OCI_API_GATEWAY_URL=https://example.apigateway.us-ashburn-1.oci.customer-oci.com/v1/feedback

# OCI Language AI Settings
OCI_LANGUAGE_ENDPOINT=https://language.aiservice.us-ashburn-1.oci.oraclecloud.com

# -----------------------------------------------------------------------------
# ORACLE AUTONOMOUS JSON DATABASE (SODA REST API)
# -----------------------------------------------------------------------------
ORACLE_SODA_URL=https://docuai23db.adb.us-ashburn-1.oraclecloudapps.com/ords/admin/soda/latest
ORACLE_DB_USER=admin
ORACLE_DB_PASSWORD=YourStrongPassword23ai!
ORACLE_SODA_COLLECTION=feedback_collection
