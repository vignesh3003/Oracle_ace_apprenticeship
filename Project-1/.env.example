# OracleDocuAI - Root Environment Configuration

# Environment Mode: 'development' (uses mock/demo fallback) or 'production' (uses real OCI)
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Backend API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# REAL ORACLE CLOUD INFRASTRUCTURE (OCI) CREDENTIALS
# (Leave as placeholders when in demo mode; populate when connecting real OCI)
# -----------------------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example_compartment_ocid
OCI_REGION=us-ashburn-1

# OCI Object Storage Settings
OCI_BUCKET_NAME=docu-ai-bucket
OCI_NAMESPACE=example_namespace

# OCI Vision AI Settings
OCI_VISION_ENDPOINT=https://vision.aiservice.us-ashburn-1.oci.oraclecloud.com

# -----------------------------------------------------------------------------
# ORACLE AUTONOMOUS DATABASE 23AI CONFIGURATION
# -----------------------------------------------------------------------------
ORACLE_DB_USER=admin
ORACLE_DB_PASSWORD=YourStrongPassword23ai!
ORACLE_DB_DSN=docuai23db_high
ORACLE_DB_WALLET_LOCATION=/app/oracle_wallet
ORACLE_DB_WALLET_PASSWORD=YourWalletPassword123!
# Set to True when connecting to local Oracle 23ai Free DB or ADB via Thin Mode without Wallet
ORACLE_DB_THIN_MODE=True
