# OracleTelemetryX - Root Environment Configuration

# Environment Mode: 'development' (uses simulation) or 'production' (uses real OCI)
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# -----------------------------------------------------------------------------
# REAL ORACLE CLOUD INFRASTRUCTURE (OCI) CREDENTIALS
# -----------------------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example_compartment_ocid
OCI_REGION=us-ashburn-1

# OCI Notification Service (ONS) Topic Settings
OCI_ONS_TOPIC_OCID=ocid1.onstopic.oc1.iad.example_ons_topic_ocid

# -----------------------------------------------------------------------------
# ORACLE AUTONOMOUS DATABASE (CONNECTION POOLING)
# -----------------------------------------------------------------------------
ORACLE_DB_USER=admin
ORACLE_DB_PASSWORD=YourStrongPassword23ai!
ORACLE_DB_DSN=docuai23db_high
ORACLE_DB_POOL_MIN=2
ORACLE_DB_POOL_MAX=10
ORACLE_DB_WALLET_LOCATION=/app/oracle_wallet
ORACLE_DB_THIN_MODE=True
